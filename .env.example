# Copy to .env and fill in. Never commit real values.
# Staging values come from the team password manager (OPS-02).
# From API-01 these are validated at startup by src/config/env.ts; the process
# refuses to start if a required one is missing.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Postgres. Local: `docker compose up -d db`. Staging: Supabase staging project (server role).
DATABASE_URL=postgres://teazy:teazy@localhost:5432/teazy

# Supabase Auth (JWT verification via JWKS) and Storage
SUPABASE_URL=https://<staging-project>.supabase.co
SUPABASE_JWKS_URL=https://<staging-project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (AI gateway, src/ai)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (test-mode keys everywhere except production)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Observability
SENTRY_DSN=
